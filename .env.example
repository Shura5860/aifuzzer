# AIFuzzer Environment Configuration Template
# Copy this file to .env and configure as needed.

# gRPC Gateway Service Host & Port
AIFUZZER_GATEWAY_HOST=127.0.0.1
AIFUZZER_GATEWAY_PORT=50051

# SQLite Database Location
AIFUZZER_DB_PATH=aifuzzer_state.sqlite

# Target Model Settings (For local test mock or Ollama)
TARGET_MODEL_PROVIDER=mock # options: mock, ollama, vllm, openai
TARGET_MODEL_NAME=mock-llama-guard
TARGET_MODEL_ENDPOINT=http://127.0.0.1:11434

# Fuzzing Campaign Defaults
FUZZ_MAX_WORKERS=4
FUZZ_MAX_ITERATIONS=1000
FUZZ_TIMEOUT_MS=5000
